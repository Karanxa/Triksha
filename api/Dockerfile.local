# Triksha API Local Development Docker Image
# Based on production structure but using local base image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies (matches prod requirements)
RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better Docker layer caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy API source code
COPY *.py ./
COPY endpoints/ ./endpoints/
COPY utils/ ./utils/
COPY detectors/ ./detectors/
COPY feature_extractors/ ./feature_extractors/
COPY mcp_detectors/ ./mcp_detectors/
COPY repo_scanner/ ./repo_scanner/
COPY data/ ./data/
COPY demo_targets.json ./

# Create directories for data persistence (matches prod structure)
RUN mkdir -p /data

# Set environment variables
ENV PYTHONPATH=/app
ENV TRIKSHA_DATA_DIR=/data

# Expose port (matches prod)
EXPOSE 8000

# Health check (matches prod)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command - start the server
CMD ["python", "main.py"]
